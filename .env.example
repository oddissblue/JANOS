# scripts/manage.py configure generates random values for these two secrets.
SECRET_KEY=change-me
POSTGRES_PASSWORD=change-me
WEB_PORT=8000
MAIL_UI_PORT=8025
PUBLIC_BASE_URL=http://localhost:8000
COOKIE_SECURE=false
# Compose defaults use Mailpit. SMTP messages appear at http://localhost:8025.
MAIL_SERVER=mailpit
MAIL_PORT=1025
MAIL_USE_SSL=false
MAIL_USE_TLS=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=janos@localhost
CONTACT_EMAIL=contact@localhost
# Local uv development: MAIL_SERVER=localhost with an SMTP service on port 1025.
# DATABASE_URL=sqlite:///database.db
# REDIS_URL=memory://
# JANOS_DATA_DIR=/absolute/path/to/runtime-data
# MODEL_PATH=/absolute/path/to/model.h5
